{
    "version": 2,
    "buildCommand": "npm run vercel-build",
    "installCommand": "npm install && npx prisma generate",
    "functions": {
        "api/**/*.ts": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "api/index.ts"
        }
    ]
}