PORT=8087

# Environment
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_exam?schema=public

# JWT secret key
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (login with Google). GOOGLE_REDIRECT_URI defaults to
# ${BACKEND_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""
GOOGLE_REDIRECT_URI=""

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Base URL of this backend - used to build email verification and password reset links
BACKEND_URL=http://localhost:8087

# SMTP (Gmail) configuration - emails fall back to console logging when unset
MAIL_FROM="noreply@aiexam.app"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_USER=""
EMAIL_PASSWORD=""

# Redis connection string (falls back to an in-memory mock in development)
REDIS_URL="redis://localhost:6379"
